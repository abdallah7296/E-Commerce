## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# .NET / tooling
project.lock.json
project.fragment.lock.json
artifacts/
node_modules/
packages/

# NuGet
*.nupkg
*.snupkg

# SQL Server local database files
*.mdf
*.ldf
*.ndf

# Publish / deployment settings
*.pubxml
*.publishproj
PublishScripts/
*.pfx
*.publishsettings

# Test / coverage output
TestResults/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# Logs and temporary files
*.log
*.tmp
*~

# Local secrets / environment files
appsettings.Development.json
appsettings.Local.json
.env
.env.*
!.env.example

# User secrets folder (if copied into repository by mistake)
secrets.json

# Visual Studio generated files
Generated\ Files/
*.pdb
*.cache
*.opendb
*.VC.db
