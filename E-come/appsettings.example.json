{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JWT": {
    "ValidIssuer": "http://localhost:5282/",
    "ValidAudience": "http://localhost:4200/",
    "Secret": "YOUR_JWT_SECRET",
    "key": "YOUR_JWT_SECRET",
    "Issuer": "SecureApi",
    "Audience": "SecureApiUser",
    "DurationInDays": 30
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_SQL_SERVER_CONNECTION_STRING"
  },
  "MailSettings": {
    "Email": "YOUR_SMTP_EMAIL",
    "DisplayName": "Postan Mole",
    "Password": "YOUR_SMTP_PASSWORD_OR_APP_PASSWORD",
    "Host": "smtp.gmail.com",
    "Port": 587
  }
}
